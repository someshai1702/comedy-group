{
  "version": 2,
  "builds": [
    {
      "src": "api/serverless.ts",
      "use": "@vercel/node"
    },
    {
      "src": "dist/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/serverless.ts" },
    { "src": "/sw.js", "dest": "/dist/sw.js" },
    { "src": "/manifest.json", "dest": "/dist/manifest.json" },
    { "src": "/(.*).js", "dest": "/dist/$1.js" },
    { "src": "/(.*).css", "dest": "/dist/$1.css" },
    { "src": "/(.*)", "dest": "/dist/index.html" }
  ]
}
