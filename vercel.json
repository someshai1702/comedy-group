{
  "version": 2,
  "builds": [
    {
      "src": "api/serverless.ts",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/serverless.ts" },
    { "src": "/assets/(.*)", "dest": "/dist/assets/$1" },
    { "src": "/sw.js", "dest": "/dist/sw.js" },
    { "src": "/manifest.json", "dest": "/dist/manifest.json" },
    { "src": "/(.*)", "dest": "/index.html", "status": 200 }
  ]
}
