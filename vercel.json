{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.ts",
      "use": "@vercel/node",
      "config": { "maxLambdaSize": "10mb" }
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    { "src": "/api/families", "dest": "/api/families.ts" },
    { "src": "/api/(.*)", "dest": "/api/index.ts" }
  ],
  "functions": {
    "api/families.ts": {
      "maxDuration": 30
    },
    "api/index.ts": {
      "maxDuration": 30
    }
  }
}
